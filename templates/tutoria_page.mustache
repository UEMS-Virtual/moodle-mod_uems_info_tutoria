{{!
    @template mod_uems_info_tutoria/tutoria_page

    Base page for the tutoring information activity.

    Context variables required for this template:
    * hasintro - Whether the activity has intro content.
    * intro - Formatted module intro HTML.
    * placeholder - Placeholder text shown until the data layer is implemented.

    Example context (json):
    {
        "hasintro": true,
        "intro": "<div class=\"no-overflow\">Intro text</div>",
        "placeholder": "Tutoring and pedagogical mediation information will be displayed here."
    }
}}
<div class="mod-uems-info-tutoria">
    {{#hasintro}}
        <div class="mod-uems-info-tutoria__intro">
            {{{intro}}}
        </div>
    {{/hasintro}}

    <section class="mod-uems-info-tutoria__placeholder" aria-live="polite">
        <h2 class="mod-uems-info-tutoria__title">{{#str}} pluginname, mod_uems_info_tutoria {{/str}}</h2>
        <p>{{placeholder}}</p>
    </section>
</div>

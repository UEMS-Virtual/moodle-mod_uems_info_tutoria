{{!
    @template mod_uemsinfotutoria/person_item_full

    Full person row — photo + name link + polos column.
    Used inside the full institutional view.

    Context variables:
    * name            - string
    * profileimageurl - string
    * messageurl      - string
    * polos_label     - string  e.g. "Polos atendidos" or "Polo"
    * polos_items     - array   e.g. [{"name": "Bataguassu", "has_separator": false}]
    * has_polos       - bool

    Example context (json):
    {
        "name": "Ana Paula Ribeiro",
        "profileimageurl": "/pluginfile.php/5/user/icon/f2",
        "messageurl": "/message/index.php?id=5",
        "polos_label": "Polos atendidos",
        "polos_items": [{"name": "Bataguassu", "has_separator": false}, {"name": "Paranhos", "has_separator": true}],
        "has_polos": true
    }
}}
<article class="uit-full-person">
    <img class="uit-photo" src="{{profileimageurl}}" alt="{{#str}} fotode, uemsinfotutoria, {{name}} {{/str}}">
    <div>
        <div class="uit-name"><a href="{{messageurl}}" target="_blank" rel="noopener noreferrer">{{name}}</a></div>
    </div>
    {{#has_polos}}
    <div class="uit-polos">
        <span class="uit-polos-label">{{polos_label}}</span>
        <span class="uit-polos-list">
            {{#polos_items}}
                <span class="uit-polo-item">{{name}}</span>
            {{/polos_items}}
        </span>
    </div>
    {{/has_polos}}
    {{^has_polos}}
    <div class="uit-polos"></div>
    {{/has_polos}}
</article>
